{
  "name": "kroegenkaraf",
  "compatibility_date": "2026-09-09",
  // De site is statisch; alleen /api/* gaat eerst langs worker/melding.js (melden en fotos).
  "main": "worker/melding.js",
  "assets": {
    "directory": "./.publication/site",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Meldingen gaan als mail naar het adres in het secret MELDING_AAN
  // (een geverifieerd bestemmingsadres in Cloudflare Email Routing).
  "send_email": [{ "name": "MELDER" }]
}
